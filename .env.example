# ==============================================================================
# AMRUTAM TELEMEDICINE BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# NOTE: Never commit `.env` or production credentials to source control.
# ==============================================================================

# Application Environment ('development', 'test', 'production')
NODE_ENV=development

# Server Port
PORT=5000

# Logging Level ('fatal', 'error', 'warn', 'info', 'debug', 'trace')
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# PRIMARY DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
#
# LOCAL DOCKER / POSTGRESQL DEFAULT:
# DATABASE_URL=postgresql://amrutam_user:amrutam_password@localhost:5432/amrutam_db?schema=public
#
# CLOUD PROVIDER (Neon / Supabase / Aiven / Render):
# If using a connection pooler (e.g. Supabase port 6543 / PgBouncer):
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:6543/[DB]?sslmode=require&schema=public"
# DIRECT_URL="postgresql://[USER]:[PASSWORD]@[HOST]:5432/[DB]?sslmode=require"
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://amrutam_user:amrutam_password@localhost:5432/amrutam_db?schema=public"
# DIRECT_URL="postgresql://amrutam_user:amrutam_password@localhost:5432/amrutam_db?schema=public"

# ------------------------------------------------------------------------------
# DEDICATED TEST DATABASE (Used for running automated integration tests)
# ------------------------------------------------------------------------------
# TEST_DATABASE_URL="postgresql://amrutam_user:amrutam_password@localhost:5432/amrutam_test_db?schema=public"
TEST_DATABASE_URL="postgresql://amrutam_user:amrutam_password@localhost:5432/amrutam_test_db?schema=public"

# ------------------------------------------------------------------------------
# REDIS (Cache & Infrastructure for background workers)
# ------------------------------------------------------------------------------
# Format: redis://[<username>:<password>@]<host>:<port>[/<db-number>]
# LOCAL REDIS:
# REDIS_URL=redis://127.0.0.1:6379
#
# CLOUD REDIS (e.g., Upstash / Redis Cloud):
# REDIS_URL="rediss://default:[YOUR_REDIS_PASSWORD]@[YOUR_REDIS_HOST]:6379"
# ------------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379"

# ------------------------------------------------------------------------------
# AUTHENTICATION & JWT CONFIGURATION (Phase 3)
# ------------------------------------------------------------------------------
# Secrets must be at least 32 characters long. Generate using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-32-character-or-longer-secret"
JWT_REFRESH_SECRET="replace-with-another-32-character-secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Cookie Security (set to true in production with HTTPS)
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# ------------------------------------------------------------------------------
# MULTI-FACTOR AUTHENTICATION (MFA) & ENCRYPTION AT REST (Phase 7)
# ------------------------------------------------------------------------------
# 256-bit encryption key used to encrypt TOTP secrets at rest via AES-256-GCM.
# Must be at least 32 characters long. Generate using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY="replace-with-a-32-character-or-longer-mfa-encryption-key"

# ------------------------------------------------------------------------------
# OBSERVABILITY, METRICS & DISTRIBUTED TRACING (Phase 10)
# ------------------------------------------------------------------------------
# Prometheus HTTP Metrics (/metrics)
METRICS_ENABLED="true"

# W3C Distributed Tracing & Optional OTLP Exporter
TRACING_ENABLED="true"
# Leave empty for local in-process trace context propagation, or specify an OTLP HTTP collector URL:
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
OTEL_EXPORTER_OTLP_ENDPOINT=""

# Container Ports & Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"

